APP_NAME="St. Cecilia Catholic Church — Parish Youth Council"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Accra

PYC_ORG_NAME="St. Cecilia Catholic Church — Parish Youth Council"
PYC_ORG_SHORT_NAME="SCC-PYC"
PYC_PARISH_NAME="St. Cecilia Catholic Church"
PYC_CURRENCY=GHS
PYC_REFERENCE_PREFIX=PYC
PYC_ACCOUNTING_BASIS=cash
PYC_MONTHLY_DUES_PESEWAS=1000
PYC_ENFORCE_ADMIN_2FA=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scc_pyc
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="St. Cecilia Parish Youth Council"
MAIL_REPLY_TO_ADDRESS=

NOTIFICATION_ENABLED=true
NOTIFICATION_QUEUE=notifications
NOTIFICATION_HIGH_QUEUE=high_priority
NOTIFICATION_BULK_QUEUE=bulk_notifications
NOTIFICATION_WEBHOOK_QUEUE=delivery_webhooks
NOTIFICATION_RETRY_LIMIT=5
NOTIFICATION_TIMEZONE=Africa/Accra

SMS_ENABLED=true
SMS_DRIVER=generic_http
SMS_ENDPOINT=
SMS_METHOD=POST
SMS_AUTH_TYPE=bearer
SMS_API_TOKEN=
SMS_SENDER_ID=SCC-PYC
SMS_TIMEOUT=20
SMS_RECIPIENT_FIELD=to
SMS_MESSAGE_FIELD=message
SMS_SENDER_FIELD=sender
SMS_DELIVERY_REPORTS=false
SMS_WEBHOOK_SECRET=

PAYSTACK_ENABLED=true
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

VITE_APP_NAME="${APP_NAME}"
